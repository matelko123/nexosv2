# syntax=docker/dockerfile:1
# Build stages run on the build machine's platform and cross-compile, so
# multi-arch images build quickly without emulation.
FROM --platform=$BUILDPLATFORM node:24-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X nexos/internal/version.Version=${VERSION}" \
      -o /out/nexos-hub ./hub/cmd/nexos-hub \
    && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/nexos-hub /nexos-hub
# Named volumes inherit this ownership on first use.
COPY --from=build --chown=65532:65532 /out/data /data
USER nonroot:nonroot
ENV NEXOS_DATA_DIR=/data
VOLUME ["/data"]
ENTRYPOINT ["/nexos-hub"]
