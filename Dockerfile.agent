# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X nexos/internal/version.Version=${VERSION}" \
      -o /out/nexos-agent ./agent/cmd/nexos-agent

FROM docker:29-cli AS dockercli

# Debian (not Alpine/distroless): the optional host features use journalctl
# (systemd journal) and apt (pending package updates) against the read-only
# host root mount; stack management uses the docker compose CLI.
FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates systemd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=build /out/nexos-agent /usr/local/bin/nexos-agent
# The root filesystem is read-only; compose keeps its config on tmpfs.
ENV NEXOS_DATA_DIR=/data \
    DOCKER_CONFIG=/tmp/docker-config
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/nexos-agent"]
CMD ["run"]
