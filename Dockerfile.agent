# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X nexos/agent/server.Version=${VERSION}" -o /out/nexos-agent ./agent/cmd/nexos-agent

# Alpine (not distroless): the docker compose CLI plugin is needed for stack
# management in a later phase.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates docker-cli docker-cli-compose
COPY --from=build /out/nexos-agent /usr/local/bin/nexos-agent
ENV NEXOS_DATA_DIR=/data
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/nexos-agent"]
CMD ["run"]
